<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash.
     Uses the 宣纸白 (#F7F4EC) paper tone from the design system so the jump
     into the first Flutter frame is seamless. Modify this file if a licensed
     full bleed Henan hero image becomes available. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/yujian_paper" />

    <!-- 启动页居中展示豫见智旅 logo；首帧绘制后由 Flutter 接管。 -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
