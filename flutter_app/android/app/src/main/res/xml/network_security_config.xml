<?xml version="1.0" encoding="utf-8"?>
<!--
  Network policy for release builds.

  Cleartext HTTP stays disabled: the shipped APK must reach the YuJianZhiLv
  backend over HTTPS only. Debug builds replace this file with a permissive copy
  (see app/src/debug/res/xml/network_security_config.xml) so that a local demo
  backend remains reachable during development.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
