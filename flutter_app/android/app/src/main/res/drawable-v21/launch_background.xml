<?xml version="1.0" encoding="utf-8"?>
<!-- API 21+ variant of the launch splash, kept identical to the base resource so
     the window background resolves consistently on every supported version. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/yujian_splash_bg" />

    <item>
        <bitmap
            android:gravity="fill"
            android:src="@drawable/splash_poster" />
    </item>
</layer-list>
