# scripts\local.env —— 本机私密配置，已被 .gitignore 忽略，不要提交。
#
# 用法：复制成 scripts\local.env 后按需填写，然后照常执行 scripts\run-server-dev.cmd。
# 格式：每行 KEY=VALUE；以 # 开头的行为注释；值里可以包含 = 与 :。

# 百度地图 Web 服务 AK（路线距离与耗时）。留空时路线会带原因降级为演示数据。
BAIDU_MAP_AK=

# 12306 车次：先启动 mcp-server-12306，再把 provider 切成 12306-mcp。
RAILWAY_PROVIDER=reference
RAILWAY_MCP_URL=http://localhost:8000/mcp
RAILWAY_CACHE_MINUTES=30

# 天气：open-meteo 免费且无需密钥，保持默认即可。
WEATHER_PROVIDER=open-meteo

# 门票价格：catalog 用景区内容库参考价；smart-buy 预留给外部比价服务。
TICKET_PROVIDER=catalog
TICKET_BASE_URL=

# 用 Android 模拟器联调图片时打开这一行（真机改成局域网 IP）。
# MEDIA_BASE_URL=http://10.0.2.2:8080

# LLM 多供应商：至少开一家，按 priority 从小到大尝试，全部失败才用 Mock 兜底。
LLM_ENABLED=false
LLM_DEEPSEEK_ENABLED=false
LLM_DEEPSEEK_API_KEY=
LLM_KIMI_ENABLED=false
LLM_KIMI_API_KEY=
LLM_QWEN_ENABLED=false
LLM_QWEN_API_KEY=

