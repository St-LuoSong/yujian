# Flutter
flutter_app/.dart_tool/
flutter_app/build/
flutter_app/.flutter-plugins*
flutter_app/android/.kotlin/

# Java
backend/server/target/
backend/server/data/
backend/server/package-lock.json

# Node
backend/admin/node_modules/
backend/admin/dist/

# Local npm cache / scratch directories used by tooling
.npm-cache/
.patch-tmp/

# Local backend archive created during migration; never part of the source tree.
backend.zip

# Local Android / Flutter toolchain (machine specific, never committed).
# See docs/DEVELOPMENT_ENVIRONMENT.md for how to install it.
tooling/flutter/
tooling/android-sdk/
tooling/.gradle/
tooling/.android/
tooling/.pub-cache/
# Dart/Flutter telemetry scratch written when APPDATA is redirected into the repo.
tooling/tmpappdata/
# Cloud/one-off deployment keys and staging artifacts. Deploy config lives outside
# the repository on purpose: see docs/DEVELOPMENT_ENVIRONMENT.md.
tooling/deploy-keys/
.flutter_template/

# IDE and local environment
.idea/
.vscode/
*.iml
.env
.env.*
!.env.example

# Local secrets loaded by scripts/run-server-dev.cmd (BAIDU_MAP_AK, LLM keys...).
scripts/local.env

# Local toolchain helper output
scripts/user-env-backup.reg

# Android release signing
flutter_app/android/key.properties
*.jks
*.keystore

# Cloud-specific deployment config.
#
# The repository ships the generic `backend/docker-compose.yml` + `Dockerfile`s so
# anyone can run the stack. The `*.cloud.*` variants are tied to one particular
# host (port bindings, deploy topology) and stay local.
backend/docker-compose.cloud.yml
backend/server/Dockerfile.cloud
backend/admin/Dockerfile.cloud

# Loose source drops at the repository root.
#
# Their processed copies are already tracked under `flutter_app/assets/`
# (`assets/icons/` with ASCII names, `assets/brand/`). Committing both would
# store the same megabytes twice for no benefit.
/icons/
/yujianlogo.png
