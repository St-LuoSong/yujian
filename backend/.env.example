# 本地与容器环境变量示例，不要提交真实密钥
SPRING_PROFILES_ACTIVE=dev
PORT=8080
APP_MODE=mock
JWT_SECRET=please-change-this-development-secret
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:5173
SHARE_BASE_URL=http://localhost:8080/share

# 运营台图片上传。文件默认落在 server/data/uploads，通过公开只读的 /media/** 提供。
# 重要：Android 模拟器访问宿主机要用 10.0.2.2，真机要用局域网 IP，否则图片地址会推导成 localhost
# 而加载不出来。这类环境请显式设置 MEDIA_BASE_URL，例如 http://10.0.2.2:8080
MEDIA_STORAGE_DIR=./data/uploads
MEDIA_BASE_URL=
MEDIA_MAX_SIZE_MB=8
MEDIA_MAX_DIMENSION=6000

# 外部工具（天气 / 地图 / 铁路）。
# live：优先真实数据源，取不到才带原因降级；mock：全部使用本地演示数据（无外网演示用）。
APP_TOOLS_MODE=live
TOOLS_TIMEOUT_SECONDS=4

# ⚠ 本文件是**模板**，会随仓库分发，不要在这里填真实密钥。
#   本机密钥请写在 scripts\local.env（已被 .gitignore 忽略，启动脚本会加载它）。
#   这个位置已经被误填过一次：AK 写在模板里 → 后端读不到 → 路线一直是演示数据。
#
# 百度地图 Web 服务 AK（可选）。留空时路线规划直接使用演示数据，
# 不会发起网络请求，也不会把演示数据冒充成实时路线。
BAIDU_MAP_AK=
BAIDU_MAP_BASE_URL=https://api.map.baidu.com

# 天气：open-meteo 免费且无需密钥，可直接验证「实时数据」这条链路；none 表示只用演示数据。
WEATHER_PROVIDER=open-meteo
WEATHER_BASE_URL=https://api.open-meteo.com
WEATHER_CACHE_MINUTES=30

# 跨城车次。
# reference：内置参考时刻表，标注为「非实时」（默认，零依赖）。
# 12306-mcp：调用独立部署的 mcp-server-12306，车次与余票来自官方接口。
#   启动方式（任选其一）：
#     docker run -d -p 8000:8000 --name mcp-12306 drfccv/mcp-server-12306:latest
#     docker compose --profile railway up -d mcp-12306
#   两种方式都不抓取网页、不保存证件信息、不代购，购票一律引导到铁路官方渠道。
RAILWAY_PROVIDER=reference
RAILWAY_MCP_URL=http://localhost:8000/mcp
RAILWAY_CACHE_MINUTES=30

# 门票价格。catalog：运营台维护的景区内容库参考价（系统资料）。
# smart-buy：预留给外部比价服务；未接入适配器时会如实降级为内容库价并标注原因。
TICKET_PROVIDER=catalog
TICKET_BASE_URL=

# MySQL 生产环境
MYSQL_USER=yujian
MYSQL_PASSWORD=yujian_dev_password
MYSQL_ROOT_PASSWORD=yujian_root_password
MYSQL_PORT=3306

# SMTP 预留，默认关闭
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yujian.local
SMTP_MOCK_CODE_LOG=true

# LLM 多供应商。至少启用一家，按 priority 从小到大尝试；某家超时或报错会
# 自动降级到下一家，全部失败后使用 Mock 稳定降级并标注“演示数据（AI 降级）”。
# 密钥只放在环境变量里，APK 与管理台都拿不到。
LLM_ENABLED=false
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=60

LLM_OPENAI_ENABLED=false
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_PRIORITY=10

LLM_DEEPSEEK_ENABLED=false
# ⚠ DeepSeek 钥匙同样写到 scripts\local.env，不要写在这里。
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_MODEL=deepseek-chat
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_DEEPSEEK_PRIORITY=20

LLM_KIMI_ENABLED=false
LLM_KIMI_API_KEY=
LLM_KIMI_MODEL=moonshot-v1-8k
LLM_KIMI_BASE_URL=https://api.moonshot.cn/v1
LLM_KIMI_PRIORITY=30

LLM_QWEN_ENABLED=false
LLM_QWEN_API_KEY=
LLM_QWEN_MODEL=qwen-plus
LLM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_QWEN_PRIORITY=40

# 运营账号（可选）。留空时不创建任何特权账号；设置后启动时会创建或提升该账号，
# 并每次启动重新写入密码，方便轮换密钥。
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
